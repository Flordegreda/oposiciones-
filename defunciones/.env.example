# Proveedor: anthropic | openai
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Carpetas de imágenes (raíz F:\SALVATIERRA)
DEFUNCIONES_IMAGES_DIR=F:\SALVATIERRA\defunciones
BAUTISMOS_IMAGES_DIR=F:\SALVATIERRA\bautismos

# Bases de datos (dentro del proyecto)
DEFUNCIONES_DB=./data/defunciones.db
BAUTISMOS_DB=./data/bautismos.db

EXTRACTION_STRATEGY=bands
API_DELAY_SECONDS=1.0
